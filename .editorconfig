root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Matches .prettierrc: Solidity uses tabWidth 4 and printWidth 160.
[*.sol]
indent_size = 4
max_line_length = 160

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
