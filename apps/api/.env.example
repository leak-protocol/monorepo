# For running apps/api outside docker. Inside docker, compose sets all of these.
# The authoritative list of variables is apps/api/src/env.ts.

LEAK_API_PORT=8787
# The API's OWN database. Do not share it with graph-node's.
LEAK_DATABASE_URL=postgres://localhost:5432/leak_api
LEAK_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/leak/subgraph
LEAK_RPC_URL=http://127.0.0.1:8545
LEAK_IPFS_API_URL=http://localhost:5001
# Required, minimum 32 characters.
LEAK_UPLOAD_JWT_SECRET=dev-only-secret-please-change-me-32b
# Browser origins allowed to call the API. Never "*": this service issues upload JWTs.
LEAK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
