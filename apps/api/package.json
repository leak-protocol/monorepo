{
  "name": "@leak/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "build:js": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx watch src/index.ts",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "prettier:write": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "test": "vitest run",
    "test:js": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "postgres": "3.4.9",
    "viem": "2.53.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.64.15",
    "@types/node": "^26.3.0",
    "@zoralabs/tsconfig": "workspace:^",
    "drizzle-kit": "0.31.10",
    "prettier": "^3.0.3",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
