# --- shared ---
# The RPC URL the BROWSER uses. Must be reachable from the host, not from inside
# the docker network.
WEB_RPC_URL=http://127.0.0.1:8545
API_URL=http://127.0.0.1:8787

# --- profiles: local, all ---
# Upstream endpoint for anvil to fork. Avalanche's public RPC is rate limited; if
# forking is slow or drops, use a dedicated endpoint.
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# --- profile: indexing ---
# The RPC URL graph-node and the API use, as seen from INSIDE the docker network.
# For the mainnet profile, set this to https://api.avax.network/ext/bc/C/rpc
GRAPH_ETHEREUM_URL=http://anvil:8545
# Subgraph name. Shared between subgraph-deploy and the API's LEAK_SUBGRAPH_URL —
# compose wires both from this variable, so do not set them separately.
SUBGRAPH_NAME=leak/subgraph
# Minimum 32 characters. Must be changed before any real deployment.
LEAK_UPLOAD_JWT_SECRET=dev-only-secret-please-change-me-32b
# Browser origins allowed to call the API. Never "*": the API issues upload JWTs.
LEAK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- profile: mainnet ---
# Required. packages/coins-deployments/addresses/43114.json is still empty, so
# these must be filled in by hand after a real deployment.
# Under the local and all profiles the deployer writes these to the shared runtime
# volume automatically — no need to set them here.
LEAK_FACTORY=0x0000000000000000000000000000000000000000
LEAK_FACTORY_DEPLOY_BLOCK=0
# The subgraph also needs the hook address to index Swapped and CoinMarketRewardsV4.
LEAK_COIN_HOOK=0x0000000000000000000000000000000000000000
