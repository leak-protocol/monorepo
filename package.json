{
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "build:js": "turbo run build:js",
    "dev": "turbo run dev",
    "fmt:sol": "prettier --write '{packages,apps}/*/src/**/*.sol'",
    "fmt:sol:check": "prettier --check '{packages,apps}/*/src/**/*.sol'",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:js": "turbo run test:js",
    "test:sol": "pnpm --filter @zoralabs/coins exec forge test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.4.1",
    "tsx": "^4.23.13",
    "turbo": "^2.5.3"
  },
  "name": "leakdotai",
  "ignore": [
    "*.template.sol"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=9 <10"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.53.1",
      "@wagmi/cli": "^2.1.0",
      "@solidity-parser/parser": "0.19.0",
      "ds-test": "https://github.com/dapphub/ds-test#cd98eff28324bfac652e63a239a60632a761790b",
      "forge-std": "https://github.com/foundry-rs/forge-std#v1.9.4",
      "tsx": "^4.19.4",
      "typescript": "^5.8.3",
      "tsup": "^8.4.0",
      "vitest": "^2.1.9",
      "elliptic": "^6.6.1",
      "ejs": "^3.1.7",
      "pbkdf2": "^3.1.3",
      "form-data": "^4.0.4",
      "braces": "^3.0.3",
      "sha.js": "^2.4.12"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
