{
  "name": "@leak/sdk",
  "version": "0.8.0",
  "repository": "https://github.com/ourzora/zora-protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "src/",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "api-codegen": "openapi-ts",
    "build": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --skipLibCheck",
    "build:js": "pnpm run build",
    "lint": "prettier --check 'src/**/*.ts'",
    "prepack": "pnpm build",
    "prettier:write": "prettier --write 'src/**/*.ts'",
    "test:js": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.8.3",
    "@leak/sdk-lite": "workspace:^"
  },
  "peerDependencies": {
    "abitype": "^1.0.8",
    "viem": "2.53.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.10",
    "@lavamoat/preinstall-always-fail": "2.0.0",
    "@types/node": "^26.4.1",
    "@types/semver": "^7.5.8",
    "@zoralabs/tsconfig": "workspace:^",
    "graphql-prettier": "^1.0.6",
    "multiformats": "^13.2.0",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.1.3",
    "semver": "^7.6.3",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
