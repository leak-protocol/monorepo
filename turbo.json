{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:js": {
      "dependsOn": [
        "^build:js"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:site": {
      "dependsOn": [
        "^build:js"
      ],
      "outputs": [
        ".vercel/output/**"
      ]
    },
    "@zoralabs/protocol-deployments#build:js": {
      "dependsOn": [
        "^build:js"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:contracts": {
      "dependsOn": [
        "^build:contracts"
      ],
      "outputs": [
        "dist/**",
        "out/**"
      ]
    },
    "build:sizes": {
      "dependsOn": [
        "^build:sizes"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:js": {
      "dependsOn": [
        "^test:js"
      ]
    },
    "test:fork": {
      "dependsOn": [
        "^test:fork"
      ]
    },
    "prettier:write": {
      "dependsOn": [
        "^prettier:write"
      ]
    },
    "storage-inspect:check": {
      "dependsOn": [
        "^storage-inspect:check"
      ]
    },
    "prepack": {
      "dependsOn": [
        "^prepack"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "update-contract-version": {
      "dependsOn": [
        "^update-contract-version"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@leak/sdk#build": {
      "dependsOn": [
        "^build:js"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@leak/sdk-lite#build": {
      "dependsOn": [
        "^build:js"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@zoralabs/coins#build:js": {
      "dependsOn": [
        "^build:js"
      ],
      "outputs": [
        "dist/**",
        "abis/**",
        "package/wagmiGenerated.ts"
      ]
    },
    "@zoralabs/coins#build": {
      "outputs": [
        "out/**"
      ]
    },
    "@leak/subgraph#build": {
      "dependsOn": [
        "^build",
        "@zoralabs/coins#build"
      ],
      "outputs": [
        "build/**",
        "generated/**",
        "abis/**",
        "subgraph.yaml"
      ]
    },
    "@leak/subgraph#test:js": {
      "dependsOn": [
        "^test:js",
        "@zoralabs/coins#build"
      ]
    }
  }
}
